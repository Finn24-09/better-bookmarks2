# Copy this file to .env and fill in your values before running docker compose.
# .env is gitignored — never commit it.

# PostgreSQL credentials
POSTGRES_USER=bb2
POSTGRES_PASSWORD=changeme
POSTGRES_DB=better_bookmarks

# JWT secret — must be at least 32 characters.
# Generate a strong one with: openssl rand -base64 48
PGRST_JWT_SECRET=change-this-to-a-long-random-string-minimum-32-characters

# Frontend API URL (used by Vite in dev mode — the proxy rewrites /api → this)
VITE_API_URL=http://localhost:3000
