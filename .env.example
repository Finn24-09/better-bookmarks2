# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control — it is listed in .gitignore.

# ── Image versions ────────────────────────────────────────────────────────────
# Pinned to the latest published release at the time of this commit.
# Update these explicitly when you have reviewed the release notes.
# Leaving any value blank silently floats to `latest` — NOT RECOMMENDED in
# production: every `docker compose up` will pull whatever GHCR returns, with
# no attestation check. Verify pinned versions with:
#   gh attestation verify oci://ghcr.io/finn24-09/better-bookmarks2-<svc>:<version> \
#     --repo Finn24-09/better-bookmarks2 \
#     --signer-workflow Finn24-09/better-bookmarks2/.github/workflows/publish-containers.yml
# Find published versions at:
#   https://github.com/Finn24-09/better-bookmarks2/pkgs/container/better-bookmarks2-frontend
#   https://github.com/Finn24-09/better-bookmarks2/pkgs/container/better-bookmarks2-email
#   https://github.com/Finn24-09/better-bookmarks2/pkgs/container/better-bookmarks2-metadata-fetcher
#   https://github.com/Finn24-09/better-bookmarks2/pkgs/container/better-bookmarks2-db
BB2_VERSION=26.5.18-2
BB2_EMAIL_VERSION=26.5.18-2
BB2_METADATA_FETCHER_VERSION=26.5.18-4
BB2_DB_VERSION=26.5.18-2

# PostgreSQL credentials
#
# IMPORTANT: POSTGRES_PASSWORD is interpolated into a postgres:// connection
# URI by docker-compose.yml (PostgREST's PGRST_DB_URI). Do NOT use the base64
# alphabet here — '/', '+', '@', ':', '?', '#', '%' are reserved in URIs and
# will silently break the connection string parser. Use a hex-only password.
# Generate with: openssl rand -hex 32
POSTGRES_USER=bb2
POSTGRES_PASSWORD=change-me-use-a-strong-random-password
POSTGRES_DB=better_bookmarks

# JWT secret used by PostgREST to sign and verify tokens.
# Not URL-embedded — base64 is safe here.
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
PGRST_JWT_SECRET=change-me-generate-a-random-secret-at-least-32-chars

# ── Email Service ─────────────────────────────────────────────────────────────

# DB password for the email_svc role (auth schema only — no access to bookmark data).
#
# IMPORTANT: same URL-encoding rule as POSTGRES_PASSWORD — this value is
# interpolated into EMAIL_DATABASE_URL in docker-compose.yml. Use a hex-only
# password. Generate with: openssl rand -hex 32
EMAIL_DB_PASSWORD=change-me-strong-random-password

# NOTE: if you override EMAIL_DATABASE_URL (or PGRST_DB_URI for the
# postgrest service) directly instead of letting docker-compose interpolate
# it from the *_PASSWORD vars above, the URL-safety guidance no longer
# applies — you are now responsible for percent-encoding any reserved
# characters (':', '/', '@', '?', '#', '%', '+', '&') in the password
# component yourself.

# Secret used to sign HttpOnly session cookies (reset token exchange).
# Not URL-embedded — base64 is safe here.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
COOKIE_SECRET=change-me-generate-a-random-secret-at-least-32-chars

# Public URL of your instance — used to build links in emails.
# No trailing slash. Must be https:// in production.
APP_BASE_URL=https://bookmarks.yourdomain.com

# SMTP — works with AWS SES (port 587 STARTTLS), Mailgun, Postmark, or any SMTP provider.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=AKIAIOSFODNN7EXAMPLE
SMTP_PASS=your-smtp-password-here
SMTP_FROM="Better Bookmarks <noreply@yourdomain.com>"

# SMTP STARTTLS enforcement. Defaults to true and is required in production —
# the email service refuses to start with SMTP_REQUIRE_TLS=false and
# NODE_ENV=production. Set to "false" ONLY for local dev pointed at MailHog
# / Mailpit (which speak plaintext SMTP on port 1025).
# SMTP_REQUIRE_TLS=true

# Optional JWT issuer pin. Leave unset unless you have a stable `iss` claim
# across your environments — enforced strictly when present, ignored when not.
# JWT_ISSUER=

# ── Metadata-Fetcher Service ──────────────────────────────────────────────────

# Backstop response body cap for the metadata-fetcher. Streaming parser
# usually stops early at </head>, so this only fires on pathological pages
# without one. Operator override range: 256 KiB floor — 8 MiB ceiling.
# A higher value also requires raising the matching mem_limit on the
# metadata-fetcher service in docker-compose.yml (32 concurrent × 8 MiB ≈
# 256 MiB working set).
# MAX_BODY_BYTES=2097152

# AWS SES specific (optional — leave blank for non-SES SMTP providers).
# The region determines the SMTP endpoint (e.g. eu-west-1 → email-smtp.eu-west-1.amazonaws.com).
AWS_SES_REGION=us-east-1
# SES Configuration Set name for delivery tracking (bounces/complaints via SNS).
# Leave blank to send without a configuration set.
AWS_SES_CONFIGURATION_SET=better-bookmarks-transactional
# Optional: SES verified identity ARN for cross-account or delegated sending.
# Format: arn:aws:ses:<region>:<account-id>:identity/<email-or-domain>
# Leave blank when sending from the same AWS account as the SMTP credentials.
AWS_SES_FROM_ARN=

